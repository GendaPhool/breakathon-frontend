{
  "name": "EventSettings",
  "type": "object",
  "properties": {
    "event_name": {
      "type": "string",
      "default": "Genda Phool Break-A-Thon"
    },
    "event_date": {
      "type": "string"
    },
    "event_time": {
      "type": "string"
    },
    "venue": {
      "type": "string"
    },
    "upi_id": {
      "type": "string"
    },
    "upi_qr_url": {
      "type": "string"
    },
    "registration_open": {
      "type": "boolean",
      "default": true
    },
    "event_started": {
      "type": "boolean",
      "default": false
    }
  },
  "required": []
}