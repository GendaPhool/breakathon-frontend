{
  "name": "Registration",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "occupation": {
      "type": "string",
      "enum": [
        "Student",
        "Working Professional",
        "Freelancer",
        "Founder",
        "Other"
      ]
    },
    "how_did_you_hear": {
      "type": "string",
      "enum": [
        "Instagram",
        "WhatsApp",
        "Friend",
        "College",
        "Startup Community",
        "LinkedIn",
        "Other"
      ]
    },
    "payment_reference": {
      "type": "string"
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "Pending Verification",
        "Verified",
        "Rejected"
      ],
      "default": "Pending Verification"
    },
    "checked_in": {
      "type": "boolean",
      "default": false
    },
    "checked_in_at": {
      "type": "string"
    },
    "participant_id": {
      "type": "string"
    },
    "badge_printed": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "name",
    "email",
    "phone",
    "city",
    "occupation",
    "how_did_you_hear",
    "payment_reference"
  ]
}